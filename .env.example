# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=arkadion
DB_PASSWORD=arkadion
DB_NAME=arkadion

# Server
PORT=3000

# Speech (speaches: faster-whisper STT + Kokoro TTS, OpenAI-compatible)
SPEACHES_BASE_URL=http://localhost:8969/v1
SPEACHES_STT_MODEL=Systran/faster-whisper-small
SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEACHES_TTS_VOICE=am_michael

# LLM provider chain (tried in order: Groq, OpenRouter, Ollama)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
